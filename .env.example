# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require&uselibpqcompat=true"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Canonical application origin used by server-side redirects, callbacks, and links.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Placeholder for the app/session signing secret when authentication is enabled.
# Generate a real secret locally or in the deployment platform; do not commit it.
AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth credentials. Do not commit real credentials.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# Google Cloud Platform
# -----------------------------------------------------------------------------

# GCP project that will host the production infrastructure.
GCP_PROJECT_ID="your-gcp-project-id"

# Optional local path for Google Application Default Credentials when needed.
# Do not commit service-account JSON files or private keys.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# -----------------------------------------------------------------------------
# Cloud Storage
# -----------------------------------------------------------------------------

# Private bucket for uploaded CSV and GSTR-2B source files.
GCP_STORAGE_BUCKET="your-storage-bucket"

# -----------------------------------------------------------------------------
# Cloud Tasks
# -----------------------------------------------------------------------------

# Queue configuration for durable background reconciliation work.
GCP_TASKS_LOCATION="your-region"
GCP_TASKS_QUEUE="your-task-queue"
